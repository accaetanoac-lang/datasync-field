{
  "expo": {
    "name": "DataSync Field",
    "slug": "datasync-field",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#367C2B"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.sincronus.datasyncfield",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "DataSync Field usa sua localização para registrar visitas a fazendas com máquinas offline.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "DataSync Field usa sua localização para registrar visitas a fazendas com máquinas offline."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFDE00"
      },
      "package": "com.sincronus.datasyncfield",
      "versionCode": 2,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.CAMERA"
      ],
      "notification": {
        "icon": "./assets/adaptive-icon.png",
        "color": "#367C2B"
      }
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Permitir que DataSync Field use sua localização."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/adaptive-icon.png",
          "color": "#367C2B"
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "DataSync Field precisa da câmera para fotografar o painel da máquina após a coleta."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "ee547311-b614-4bf5-981a-9f127f7ff445"
      }
    }
  }
}
